---
import Base from '../layouts/Base.astro';
import PostRows from '../components/PostRows.astro';
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const topics = CATEGORIES.filter((c) => posts.some((p) => p.data.category === c.slug));
const latest = posts.slice(0, 12);
---
<Base title={SITE.name} description="Plain-language guides to mutual funds, insurance, credit and tax in India. Educational only, with no product recommendations.">
  <section>
    <h1>{SITE.tagline}</h1>
    <p class="lede">Guides to mutual funds, insurance, credit and tax. Each one explains how something works and what to check in the official document. We do not recommend products or promise returns.</p>
  </section>
  {topics.length > 0 && (
    <section aria-labelledby="topics">
      <h2 id="topics">Browse by topic</h2>
      <ul class="rows topics">
        {topics.map((c) => (
          <li>
            <a href={`/category/${c.slug}/`}>{c.label}</a>
            <span class="muted">{c.blurb}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
  <section aria-labelledby="latest">
    <h2 id="latest">Latest guides</h2>
    <PostRows posts={latest} />
  </section>
</Base>
