  'insurance': '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  'credit-and-loans': '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/>',
  'tax': '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M10 12h5"/><path d="M10 16h5"/>',
  'banking-and-savings': '<path d="M3 9l9-5 9 5"/><path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8"/><path d="M3 20h18"/>',
  'investing-basics': '<path d="M8 5h9"/><path d="M8 9h9"/><path d="M8 5h2.5c3 0 4.5 1.8 4.5 4s-1.5 4-4.5 4H8l7 6"/>',
};
const inner = icons[slug] ?? '<circle cx="12" cy="12" r="8"/>';
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={inner} />
