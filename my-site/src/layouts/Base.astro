---
import '@fontsource-variable/source-serif-4/wght.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';
import { getPosts } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
}
const { title, description, type = 'website', jsonLd = [], noindex = false } = Astro.props;

const siteNoindex = import.meta.env.PUBLIC_NOINDEX !== 'false';
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : `${title} | ${SITE.name}`;

const posts = await getPosts();
const navCats = CATEGORIES.filter((c) => posts.some((p) => p.data.category === c.slug));
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(siteNoindex || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wide bar">
        <a class="brand" href="/"><Logo />{SITE.name}</a>
        {navCats.length > 0 && (
          <nav class="mnav" aria-label="Topics">
            <ul>
              {navCats.map((c) => <li><a href={`/category/${c.slug}/`}>{c.label}</a></li>)}
            </ul>
          </nav>
        )}
      </div>
    </header>
    <main id="main" class="wide">
      <slot />
    </main>
    <slot name="bleed" />
    <footer class="footer">
      <div class="wide foot-grid">
        <div>
          <a class="brand" href="/"><Logo />{SITE.name}</a>
          <p>Plain-language guides to money in India. Educational only, with no product recommendations.</p>
        </div>
        <nav aria-label="Topics">
          <h2>Topics</h2>
          <ul>
            {navCats.map((c) => <li><a href={`/category/${c.slug}/`}>{c.label}</a></li>)}
          </ul>
        </nav>
        <nav aria-label="About the site">
          <h2>The site</h2>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/editorial-policy/">Editorial policy</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </nav>
        <nav aria-label="Legal">
          <h2>Legal</h2>
          <ul>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/disclaimer/">Disclaimer</a></li>
          </ul>
        </nav>
      </div>
      <div class="wide foot-base">
        <p>Educational information only. Not investment, tax, legal or insurance advice. Copyright {year} {SITE.name}.</p>
      </div>
    </footer>
  </body>
</html>
